# =============================================================================
# The Grand Roundhouse — copy to .env.local (never commit .env.local)
# Production: set the same keys in Vercel / your host → Environment Variables
# =============================================================================

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- First admin only: /register + ADMIN_SETUP_KEY ---------------------------
ADMIN_SETUP_KEY=change-me-to-a-long-random-secret-min-8-chars

# --- After first admin exists (production): block public /register ----------
# NEXT_PUBLIC_DISABLE_ADMIN_REGISTER=1
# DISABLE_ADMIN_REGISTER=1

# --- Optional ----------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
# NEXT_PUBLIC_MAINTENANCE_MODE=1
# NEXT_PUBLIC_SITE_NAME=The Grand Round House
# INVOICE_VENUE_ADDRESS=Lodge Avenue, Dagenham, RM8 2HY
